<?xml version="1.0" encoding="utf-8" ?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#5E2FD0" android:endColor="#2F76CC" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1B2438" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/ritm_accent" android:endColor="@color/ritm_accent2" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
